<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NuYu Weight Loss Program Dashboard</title>
    <style>
        :root {
            --primary: #121840;
            --secondary: #F2B3A9;
            --accent1: #FFFFFF;
            --accent2: #D6C0A9;
            --accent3: #AC8861;
            --light: #f8f5f2;
            --dark: #121840;
            --danger: #F2B3A9;
            --warning: #D6C0A9;
            --success: #AC8861;
            --text: #121840;
            --background: #f8f5f2;
            --card-bg: #FFFFFF;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: var(--background);
            color: var(--text);
            line-height: 1.6;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        
        .logo {
            font-size: 28px;
            font-weight: 700;
            color: var(--primary);
        }
        
        .logo span {
            color: var(--secondary);
        }
        
        .header {
            background-color: var(--primary);
            color: var(--accent1);
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 30px;
        }
        
        .logo, .user-name {
            color: var(--accent1);
        }
        
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-color: var(--secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-weight: bold;
            font-size: 20px;
        }
        
        .dashboard-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: var(--dark);
        }
        
        .cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .card {
            background-color: var(--card-bg);
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .card-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .card-value {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 10px;
        }
        
        .card-subtitle {
            font-size: 14px;
            color: var(--dark);
            opacity: 0.8;
        }
        
        .positive {
            color: var(--success);
        }
        
        .negative {
            color: var(--danger);
        }
        
        .progress-container {
            margin-top: 10px;
        }
        
        .progress-bar {
            height: 8px;
            width: 100%;
            background-color: var(--light);
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 5px;
        }
        
        .progress-fill {
            height: 100%;
            background-color: var(--secondary);
            border-radius: 4px;
        }
        
        .card {
            border-left: 4px solid var(--primary);
        }
        
        .progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: var(--dark);
            opacity: 0.8;
        }
        
        .chart-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .chart-card {
            background-color: var(--card-bg);
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            height: 350px;
        }
        
        .activity-container {
            background-color: var(--card-bg);
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .activity-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--dark);
        }
        
        .activity-list {
            list-style: none;
        }
        
        .activity-item {
            padding: 15px 0;
            border-bottom: 1px solid var(--light);
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .activity-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
        }
        
        .activity-details {
            flex: 1;
        }
        
        .activity-name {
            font-weight: 600;
            margin-bottom: 5px;
        }
        
        .activity-meta {
            font-size: 12px;
            color: var(--dark);
            opacity: 0.8;
        }
        
        .nutrition-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .donut-chart {
            text-align: center;
            position: relative;
        }
        
        .donut-chart svg {
            width: 150px;
            height: 150px;
            margin: 0 auto;
        }
        
        .donut-chart-label {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }
        
        .donut-chart-value {
            font-size: 24px;
            font-weight: 700;
            display: block;
        }
        
        .donut-chart-title {
            font-size: 12px;
            color: var(--dark);
            opacity: 0.8;
        }
        
        .nutrition-details {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }
        
        .nutrition-item {
            text-align: center;
        }
        
        .nutrition-value {
            font-size: 18px;
            font-weight: 700;
            display: block;
        }
        
        .nutrition-label {
            font-size: 12px;
            color: var(--dark);
            opacity: 0.8;
        }
        
        .bottom-container {
            display: grid;
            grid-template-columns: 3fr 2fr;
            gap: 20px;
        }
        
        .calendar-container {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
            margin-top: 15px;
        }
        
        .calendar-header {
            text-align: center;
            font-weight: 600;
            font-size: 12px;
            color: var(--dark);
            opacity: 0.8;
        }
        
        .calendar-day {
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 5px;
            font-size: 12px;
            background-color: var(--light);
            position: relative;
        }
        
        .calendar-day.active {
            background-color: var(--secondary);
            color: var(--primary);
            font-weight: bold;
        }
        
        .calendar-day.has-workout::after {
            content: '';
            position: absolute;
            bottom: 3px;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background-color: var(--primary);
        }
        
        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 12px;
            color: var(--dark);
            opacity: 0.6;
        }
    </style>
</head>
